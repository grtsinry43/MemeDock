/.agents/
/.codex/
/.aws/
.env
.env.*
!.env.example
*.keystore
*.jks
local.properties

# Rust and Android build outputs; keep Cargo.lock for application builds.
/target/
**/target/
**/.gradle/
**/.kotlin/
**/build/
**/.cxx/
**/.externalNativeBuild/
*.apk
*.aab
/apps/android/app/release/
/packaging/arch/**/src/
/packaging/arch/**/pkg/
/packaging/arch/**/*.tar.*
/packaging/arch/**/memedock-*-SHA256SUMS

# IDE and operating-system files.
.idea/
.vscode/
.DS_Store
*~

# Local runtime data must not enter the source repository.
/data/
/cache/
*.sqlite
*.sqlite-*
*.db
*.db-*

# AGENTS.md is a tracked project instruction file, not a design document.
!AGENTS.md
