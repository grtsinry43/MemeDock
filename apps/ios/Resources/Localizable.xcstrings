  "strings": {
    "The backup is incomplete or damaged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup is incomplete or damaged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份文件不完整或已损坏"
          }
        }
      }
    },
    "This backup format is not supported.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup format is not supported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不受支持的备份文件格式"
