        }
      }
    },
    "Allow MemeDock to add photos in Settings, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow MemeDock to add photos in Settings, then try again."
