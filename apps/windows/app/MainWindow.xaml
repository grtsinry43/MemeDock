<Window
    x:Class="MemeDock.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MemeDock.Windows"
    xmlns:views="using:MemeDock.Windows.Views"
    Title="MemeDock">
    <Grid x:Name="Root" Loaded="OnLoaded">
        <Grid.Resources>
            <!-- Named copies of the theme brushes picked from code; ThemeResource keeps
                 them in step with the theme applied to this root. -->
            <SolidColorBrush x:Key="SyncIdleBrush" Color="{ThemeResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="SyncAttentionBrush" Color="{ThemeResource SystemFillColorCaution}" />
            <SolidColorBrush x:Key="SyncFailureBrush" Color="{ThemeResource SystemFillColorCritical}" />
            <SolidColorBrush x:Key="InspectorOverlayBrush" Color="{ThemeResource SolidBackgroundFillColorTertiary}" />
            <Style x:Key="TileContainerStyle" TargetType="GridViewItem">
                <Setter Property="Margin" Value="4" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearch" />
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnImportShortcut" />
            <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="OnSelectAllShortcut" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="OnCopyShortcut" />
            <KeyboardAccelerator Key="Delete" Invoked="OnDeleteShortcut" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="WindowTitleBar" Title="MemeDock" Height="48"
                  IsPaneToggleButtonVisible="True" PaneToggleRequested="OnPaneToggle">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource><FontIconSource Glyph="&#xE7F4;" /></TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox x:Name="Search" IsEnabled="False" QueryIcon="Find" MinWidth="240" MaxWidth="560"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                TextChanged="OnSearchChanged" Loaded="OnSearchLoaded" />
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <Button x:Name="SyncStatusButton" Visibility="Collapsed" Click="OnOpenSyncSettings"
                        Style="{StaticResource SubtleButtonStyle}" Padding="10,6" Margin="0,0,4,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="SyncStatusIcon" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="SyncStatusLabel" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto" OpenPaneLength="260"
                        IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="True"
                        SelectionChanged="OnNavigationChanged" ItemInvoked="OnNavigationInvoked" Loaded="OnNavigationLoaded">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="AllNavigation" Tag="all">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80A;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="StarredNavigation" Tag="starred">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="RecentNavigation" Tag="recent">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader x:Name="CollectionsHeader" />
                <NavigationViewItem x:Name="NewCollectionNavigation" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE710;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader x:Name="TagsHeader" />
                <NavigationViewItem x:Name="NewTagNavigation" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE710;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="TrashNavigation" Tag="trash">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE74D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <SplitView x:Name="Inspector" PanePlacement="Right" OpenPaneLength="320" DisplayMode="Inline" IsPaneOpen="False"
                           PaneBackground="Transparent" SizeChanged="OnInspectorSizeChanged" PaneClosed="OnInspectorPaneClosed">
                    <SplitView.Resources>
                        <!-- Keep the native pane entrance, without translating the whole gallery as well. -->
                        <x:String x:Key="SplitViewPaneAnimationOpenPreDuration">00:00:00</x:String>
                        <x:String x:Key="SplitViewPaneAnimationCloseDuration">00:00:00</x:String>
                    </SplitView.Resources>
                    <SplitView.Pane>
                        <Grid x:Name="InspectorPane" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                            <views:StickerDetailView x:Name="Details" CloseRequested="OnInspectorClose" />
                            <views:BatchOrganizeView x:Name="Batch" Visibility="Collapsed" CloseRequested="OnInspectorClose"
                                                     SelectAllRequested="OnSelectAll" ClearRequested="OnClearSelection" />
                        </Grid>
                    </SplitView.Pane>

                    <Grid x:Name="LibraryContent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Padding="24,16,12,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.Heading, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <TextBlock x:Name="CountLabel" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                            </StackPanel>
                            <CommandBar x:Name="Commands" Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right"
                                        IsDynamicOverflowEnabled="True" VerticalAlignment="Center">
                                <AppBarButton x:Name="ReorderDone" Visibility="Collapsed" Click="OnReorderDone">
                                    <AppBarButton.Icon><FontIcon Glyph="&#xE73E;" /></AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="RestoreButton" Visibility="Collapsed" Click="OnRestoreSelected">
                                    <AppBarButton.Icon><FontIcon Glyph="&#xE777;" /></AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="PurgeButton" Visibility="Collapsed" Click="OnPurgeSelected">
                                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="ImportButton" IsEnabled="False" Click="OnImport" KeyboardAcceleratorTextOverride="Ctrl+O">
                                    <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="SortButton">
                                    <AppBarButton.Icon><FontIcon Glyph="&#xE8CB;" /></AppBarButton.Icon>
                                    <AppBarButton.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <RadioMenuFlyoutItem x:Name="SortRecent" Tag="Recent" GroupName="sort" Click="OnSort" />
                                            <RadioMenuFlyoutItem x:Name="SortUsed" Tag="LastUsed" GroupName="sort" Click="OnSort" />
                                            <RadioMenuFlyoutItem x:Name="SortCollection" Tag="CollectionOrder" GroupName="sort" Click="OnSort" />
                                            <MenuFlyoutSeparator x:Name="ReorderSeparator" />
                                            <ToggleMenuFlyoutItem x:Name="ReorderMenu" Click="OnReorder" />
                                        </MenuFlyout>
                                    </AppBarButton.Flyout>
                                </AppBarButton>
                                <AppBarToggleButton x:Name="SelectToggle" Click="OnToggleSelecting">
                                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE762;" /></AppBarToggleButton.Icon>
                                </AppBarToggleButton>
                            </CommandBar>
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="8" Padding="24,0,24,0">
                            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" Margin="0,0,0,8">
                                <InfoBar.ActionButton><Button x:Name="RetryButton" Click="OnRetry" /></InfoBar.ActionButton>
                            </InfoBar>
                            <InfoBar x:Name="CatalogErrorBar" Severity="Warning" IsClosable="False" Margin="0,0,0,8" />
                            <Grid x:Name="ImportStrip" Visibility="Collapsed" ColumnSpacing="12" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="ImportProgress" Minimum="0" Maximum="1" VerticalAlignment="Center" />
                                <TextBlock x:Name="ImportStatus" Grid.Column="1" Style="{StaticResource SecondaryCaptionTextBlockStyle}" VerticalAlignment="Center" />
                            </Grid>
                            <views:TrashGroupsView x:Name="TrashGroupsPanel" Visibility="Collapsed" Margin="0,0,0,8" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <GridView x:Name="Gallery" ItemsSource="{x:Bind ViewModel.Cards}" SelectionMode="Extended"
                                      IsMultiSelectCheckBoxEnabled="True" Padding="20,0,16,24"
                                      ItemContainerStyle="{StaticResource TileContainerStyle}"
                                      SelectionChanged="OnSelectionChanged" SizeChanged="OnGallerySizeChanged"
                                      ContainerContentChanging="OnContainerContentChanging" Loaded="OnGalleryLoaded"
                                      DoubleTapped="OnGalleryDoubleTapped" KeyDown="OnGalleryKeyDown"
                                      RightTapped="OnGalleryRightTapped"
                                      IsItemClickEnabled="True" ItemClick="OnGalleryItemClick"
                                      DragItemsCompleted="OnGalleryReordered" DragItemsStarting="OnGalleryDragStarting"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <GridView.ItemContainerTransitions>
                                    <TransitionCollection>
                                        <AddDeleteThemeTransition />
                                        <ReorderThemeTransition />
                                        <EntranceThemeTransition IsStaggeringEnabled="False" />
                                    </TransitionCollection>
                                </GridView.ItemContainerTransitions>
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="136" ItemHeight="158" /></ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="local:StickerCard">
                                        <Grid Padding="8" RowSpacing="6" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="16" />
                                            </Grid.RowDefinitions>
                                            <Image x:Name="TileImage" Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform"
                                                   AutomationProperties.Name="{x:Bind Title, Mode=OneWay}" />
                                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <FontIcon Glyph="&#xE735;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                          Visibility="{x:Bind local:MainWindow.ToVisibility(Starred), Mode=OneWay}" />
                                                <FontIcon Glyph="&#xE768;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          Visibility="{x:Bind local:MainWindow.ToVisibility(Animated), Mode=OneWay}" />
                                            </StackPanel>
                                            <Button Tag="{x:Bind}" Click="OnRetryThumbnail" Loaded="OnThumbnailRetryLoaded"
                                                    Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{x:Bind local:MainWindow.ToVisibility(ThumbnailFailed), Mode=OneWay}">
                                                <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                            </Button>
                                            <TextBlock Grid.Row="1" Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>

                            <ProgressRing x:Name="Busy" Width="32" Height="32" IsActive="False" Visibility="Collapsed"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="8" MaxWidth="380" Padding="24">
                                <FontIcon x:Name="EmptyIcon" Glyph="&#xE80A;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="{x:Bind ViewModel.EmptyHeading, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                                <TextBlock x:Name="EmptyHint" TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button x:Name="EmptyAction" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center"
                                        Margin="0,12,0,0" Click="OnEmptyAction" />
                            </StackPanel>

                            <StackPanel x:Name="FailureState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="8" MaxWidth="380" Padding="24">
                                <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Margin="0,0,0,8" />
                                <TextBlock x:Name="FailureTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center" />
                                <TextBlock x:Name="FailureMessage" TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button x:Name="FailureRetry" HorizontalAlignment="Center" Margin="0,12,0,0" Click="OnRetry" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </SplitView>

                <views:SettingsView x:Name="Settings" Visibility="Collapsed" />

                <views:NoticeBar x:Name="Notice" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,24" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
