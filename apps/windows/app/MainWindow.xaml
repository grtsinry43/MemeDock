<Window
    x:Class="MemeDock.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MemeDock.Windows"
    Title="MemeDock">
    <Grid x:Name="Root" Padding="28" RowSpacing="20" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Loaded="OnLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="MemeDock" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="收好每一张表情，随时找到想用的那张。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button x:Name="ImportButton" Grid.Column="1" Content="导入图片" IsEnabled="False" Click="OnImport" VerticalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" />
        </Grid>
        <TextBox x:Name="Search" Grid.Row="1" PlaceholderText="搜索表情名称、备注或标签" TextChanged="OnSearchChanged" IsEnabled="False" MaxWidth="640" HorizontalAlignment="Stretch" />
        <Grid Grid.Row="2">
            <GridView x:Name="Gallery" ItemsSource="{x:Bind Cards}" SelectionMode="Single"
                      ContainerContentChanging="OnContainerContentChanging" Loaded="OnGalleryLoaded"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:StickerCard">
                        <Grid Width="152" Margin="4" RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="144" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="10">
                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" AutomationProperties.Name="{x:Bind Title}" />
                            </Border>
                            <TextBlock Grid.Row="1" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1" Margin="4,0" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <TextBlock x:Name="EmptyState" Text="还没有表情，导入几张喜欢的图片吧。" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ProgressRing x:Name="Busy" Width="18" Height="18" IsActive="True" />
            <TextBlock x:Name="Status" Grid.Column="1" Text="正在打开表情库…" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
