<Window
    x:Class="MemeDock.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MemeDock.Windows"
    xmlns:views="using:MemeDock.Windows.Views"
    Title="MemeDock">
    <Grid x:Name="Root" Loaded="OnLoaded">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearch" />
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnImportShortcut" />
            <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="OnSelectAllShortcut" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="OnCopyShortcut" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="WindowTitleBar" Title="MemeDock" IsPaneToggleButtonVisible="True" PaneToggleRequested="OnPaneToggle">
            <TitleBar.IconSource><FontIconSource Glyph="&#xE7F4;" /></TitleBar.IconSource>
        </TitleBar>
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto" OpenPaneLength="240"
                        IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False" SelectionChanged="OnNavigationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="AllNavigation" Tag="all" Icon="AllApps" />
                <NavigationViewItem x:Name="StarredNavigation" Tag="starred" Icon="Favorite" />
                <NavigationViewItem x:Name="RecentNavigation" Tag="recent" Icon="Clock" />
                <NavigationViewItem x:Name="TrashNavigation" Tag="trash" Icon="Delete" />
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Name="CollectionsNavigation" Icon="Library" SelectsOnInvoked="False" />
                <NavigationViewItem x:Name="TagsNavigation" Tag="tags" Icon="Tag" IsEnabled="False" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="CatalogNavigation" Tag="catalog" Icon="Edit" />
                <NavigationViewItem x:Name="SettingsNavigation" Tag="settings" Icon="Setting" />
            </NavigationView.FooterMenuItems>
            <Grid>
                <Border Margin="0,0,8,8" Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <SplitView x:Name="Inspector" PanePlacement="Right" OpenPaneLength="340" DisplayMode="Inline" IsPaneOpen="False" SizeChanged="OnInspectorSizeChanged" PaneClosed="OnInspectorPaneClosed">
                        <SplitView.Resources>
                            <!-- Keep the native pane entrance, without translating the whole gallery as well. -->
                            <x:String x:Key="SplitViewPaneAnimationOpenPreDuration">00:00:00</x:String>
                            <x:String x:Key="SplitViewPaneAnimationCloseDuration">00:00:00</x:String>
                        </SplitView.Resources>
                        <SplitView.Pane>
                            <Grid>
                                <views:StickerDetailView x:Name="Details" CloseRequested="OnInspectorClose" />
                                <views:BatchOrganizeView x:Name="Batch" Visibility="Collapsed" CloseRequested="OnInspectorClose" />
                            </Grid>
                        </SplitView.Pane>
                    <Grid x:Name="LibraryContent" Padding="24" RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.Heading, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="ReorderDone" Visibility="Collapsed" Style="{StaticResource SubtleButtonStyle}" Click="OnReorderDone" />
                                <Button x:Name="ImportButton" IsEnabled="False" Click="OnImport" Style="{ThemeResource AccentButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="16" /><TextBlock x:Name="ImportLabel" /></StackPanel></Button>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="SearchRow" Grid.Row="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid>
                            <TextBox x:Name="Search" IsEnabled="False" Padding="36,6,12,6" HorizontalAlignment="Stretch"
                                     TextChanged="OnSearchChanged" TextCompositionStarted="OnCompositionStarted" TextCompositionEnded="OnCompositionEnded" />
                            <FontIcon Glyph="&#xE721;" FontSize="16" Margin="12,0" HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <DropDownButton x:Name="SortButton" Grid.Column="1" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8CB;" FontSize="16" />
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <RadioMenuFlyoutItem x:Name="SortRecent" Tag="Recent" GroupName="sort" Click="OnSort" />
                                        <RadioMenuFlyoutItem x:Name="SortUsed" Tag="LastUsed" GroupName="sort" Click="OnSort" />
                                        <RadioMenuFlyoutItem x:Name="SortCollection" Tag="CollectionOrder" GroupName="sort" Click="OnSort" />
                                        <MenuFlyoutSeparator />
                                        <ToggleMenuFlyoutItem x:Name="ReorderMenu" Click="OnReorder" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </Grid>
                        <StackPanel Grid.Row="2" Spacing="8">
                            <ComboBox x:Name="TagSelector" Visibility="Collapsed" ItemsSource="{x:Bind ViewModel.Tags}"
                                      DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="OnTagChanged" MinWidth="160" MaxWidth="400" />
                            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False">
                                <InfoBar.ActionButton><Button x:Name="RetryButton" Click="OnRetry" /></InfoBar.ActionButton>
                            </InfoBar>
                            <InfoBar x:Name="CatalogErrorBar" Severity="Warning" IsClosable="False" />
                            <InfoBar x:Name="OutputErrorBar" Severity="Error" IsClosable="False" />
                            <InfoBar x:Name="OperationBar" Severity="Success" IsOpen="False">
                                <InfoBar.ActionButton><Button x:Name="UndoButton" Click="OnUndoDelete" /></InfoBar.ActionButton>
                            </InfoBar>
                            <Grid x:Name="SelectionBar" Visibility="Collapsed" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}" />
                                    <TextBlock x:Name="SelectionHint" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="RestoreButton" Grid.Column="1" Visibility="Collapsed" Click="OnRestoreSelected" VerticalAlignment="Center" />
                                <Button x:Name="PurgeButton" Grid.Column="2" Visibility="Collapsed" Click="OnPurgeSelected" VerticalAlignment="Center" />
                                <AppBarButton x:Name="SelectAllButton" Grid.Column="3" Icon="SelectAll" LabelPosition="Collapsed" Click="OnSelectAll" VerticalAlignment="Center" />
                                <AppBarButton x:Name="ClearSelectionButton" Grid.Column="4" Icon="Cancel" LabelPosition="Collapsed" Click="OnClearSelection" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                        <views:TrashGroupsView x:Name="TrashGroupsPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,0,0,8" />
                        <Grid Grid.Row="4">
                            <GridView x:Name="Gallery" ItemsSource="{x:Bind ViewModel.Cards}" SelectionMode="Extended"
                                      IsMultiSelectCheckBoxEnabled="True" SelectionChanged="OnSelectionChanged"
                                      ContainerContentChanging="OnContainerContentChanging" Loaded="OnGalleryLoaded"
                                      DoubleTapped="OnGalleryDoubleTapped" KeyDown="OnGalleryKeyDown"
                                      RightTapped="OnGalleryRightTapped"
                                      IsItemClickEnabled="True" ItemClick="OnGalleryItemClick"
                                      DragItemsCompleted="OnGalleryReordered"
                                      DragItemsStarting="OnGalleryDragStarting"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <GridView.ItemContainerTransitions><TransitionCollection><AddDeleteThemeTransition /><ReorderThemeTransition /></TransitionCollection></GridView.ItemContainerTransitions>
                                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="local:StickerCard">
                                        <Grid Width="144" Margin="4" RowSpacing="8" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
                                            <Grid.RowDefinitions><RowDefinition Height="136" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="8">
                                                <Grid>
                                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" AutomationProperties.Name="{x:Bind Title, Mode=OneWay}" />
                                                    <FontIcon Glyph="&#xE735;" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                              Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind local:MainWindow.ToVisibility(Starred), Mode=OneWay}" />
                                                    <FontIcon Glyph="&#xE714;" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                              Visibility="{x:Bind local:MainWindow.ToVisibility(Animated), Mode=OneWay}" />
                                                    <Button Tag="{x:Bind}" Click="OnRetryThumbnail" Loaded="OnThumbnailRetryLoaded" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{x:Bind local:MainWindow.ToVisibility(ThumbnailFailed), Mode=OneWay}">
                                                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1" Margin="4,0" />
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="360">
                                <FontIcon Glyph="&#xEB9F;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.EmptyHeading, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center" />
                                <TextBlock x:Name="EmptyHint" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="5" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ProgressRing x:Name="Busy" Width="18" Height="18" IsActive="True" />
                            <TextBlock x:Name="Status" Grid.Column="1" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    </SplitView>
                </Border>
                <views:SettingsView x:Name="Settings" Visibility="Collapsed" />
                <views:CatalogView x:Name="Catalog" Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
