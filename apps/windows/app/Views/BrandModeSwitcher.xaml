<UserControl
    x:Class="MemeDock.Windows.Views.BrandModeSwitcher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button x:Name="TriggerButton" Style="{StaticResource SubtleButtonStyle}"
            Padding="8,4" VerticalAlignment="Center">
        <Button.Flyout>
            <Flyout x:Name="ModeFlyout" Placement="BottomEdgeAlignedLeft" Opening="OnFlyoutOpening" Closed="OnFlyoutClosed">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="Padding" Value="6" />
                        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                        <Setter Property="MinWidth" Value="268" />
                    </Style>
                </Flyout.FlyoutPresenterStyle>
                <StackPanel Spacing="4">
                    <Button x:Name="DockOption" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Padding="10,8" Click="OnSelectDock" Style="{StaticResource SubtleButtonStyle}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DockIconBadge" Width="32" Height="32" CornerRadius="6"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <FontIcon x:Name="DockIconGlyph" Glyph="&#xE80A;" FontSize="15"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="MemeDock" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="DockSubtitle" Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                            <FontIcon x:Name="DockCheck" Grid.Column="2" Glyph="&#xE73E;" FontSize="12"
                                      VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Name="CreatorOption" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Padding="10,8" Click="OnSelectCreator" Style="{StaticResource SubtleButtonStyle}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CreatorIconBadge" Width="32" Height="32" CornerRadius="6"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <FontIcon x:Name="CreatorIconGlyph" Glyph="&#xE714;" FontSize="15"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Meme Creator" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="CreatorSubtitle" Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                            <FontIcon x:Name="CreatorCheck" Grid.Column="2" Glyph="&#xE73E;" FontSize="12"
                                      VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Flyout>
        </Button.Flyout>

        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Image Source="ms-appx:///Assets/MemeDock.png" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="Meme" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="ModeSuffix" Text="Dock" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <FontIcon x:Name="Chevron" Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="-2,1,0,0" />
        </StackPanel>
    </Button>
</UserControl>
