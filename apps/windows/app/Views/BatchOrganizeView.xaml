<UserControl x:Class="MemeDock.Windows.Views.BatchOrganizeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:MemeDock.Windows.ViewModels">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Padding="16,8,4,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="Heading" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Collapsed" OverflowButtonVisibility="Collapsed" IsDynamicOverflowEnabled="False">
                <AppBarButton x:Name="CloseButton" Click="OnClose"><AppBarButton.Icon><FontIcon Glyph="&#xE711;" /></AppBarButton.Icon></AppBarButton>
            </CommandBar>
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Padding="16,4,16,24">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="Count" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="Hint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SelectAllButton" Click="OnSelectAll" />
                    <Button x:Name="ClearButton" Click="OnClearSelection" />
                </StackPanel>
                <InfoBar x:Name="ErrorBar" IsClosable="False" Severity="Error" />

                <ContentControl x:Name="Actions" HorizontalContentAlignment="Stretch" IsTabStop="False">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="OrganizeLabel" Style="{StaticResource PaneSectionTextBlockStyle}" />
                    <DropDownButton x:Name="AssignButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" FontSize="16" /><TextBlock x:Name="AssignLabel" /></StackPanel>
                        <DropDownButton.Flyout><MenuFlyout x:Name="CollectionMenu" Placement="BottomEdgeAlignedLeft" Opening="OnCollectionMenuOpening" /></DropDownButton.Flyout>
                    </DropDownButton>
                    <DropDownButton x:Name="AddTagsButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8EC;" FontSize="16" /><TextBlock x:Name="AddTagsLabel" /></StackPanel>
                        <DropDownButton.Flyout><MenuFlyout x:Name="AddTagsMenu" Placement="BottomEdgeAlignedLeft" Opening="OnAddTagsOpening" /></DropDownButton.Flyout>
                    </DropDownButton>
                    <DropDownButton x:Name="RemoveTagsButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE738;" FontSize="16" /><TextBlock x:Name="RemoveTagsLabel" /></StackPanel>
                        <DropDownButton.Flyout><MenuFlyout x:Name="RemoveTagsMenu" Placement="BottomEdgeAlignedLeft" Opening="OnRemoveTagsOpening" /></DropDownButton.Flyout>
                    </DropDownButton>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Name="StarButton" HorizontalAlignment="Stretch" Click="OnStar" />
                        <Button x:Name="UnstarButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnUnstar" />
                    </Grid>
                    <Border Height="1" Margin="0,8" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button x:Name="DeleteButton" HorizontalAlignment="Stretch" Click="OnDelete">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock x:Name="DeleteLabel" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                </ContentControl>

                <StackPanel Spacing="8">
                    <TextBlock x:Name="Progress" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                    <ProgressBar x:Name="Running" IsIndeterminate="True" Visibility="Collapsed" />
                    <Button x:Name="StopButton" Visibility="Collapsed" Click="OnStop" />
                </StackPanel>
                <ListView x:Name="Results" SelectionMode="None" MaxHeight="260">
                    <ListView.ItemTemplate><DataTemplate x:DataType="models:BatchRow"><StackPanel Spacing="2" Padding="0,6">
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Error}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                    </StackPanel></DataTemplate></ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
