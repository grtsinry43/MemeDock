<UserControl
    x:Class="MemeDock.Windows.Views.Creator.CreatorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:creator="using:MemeDock.Windows.Views.Creator"
    AllowDrop="True"
    DragOver="OnDragOver"
    DragLeave="OnDragLeave"
    Drop="OnDrop"
    KeyDown="OnCreatorKeyDown"
    CharacterReceived="OnCreatorCharacterReceived"
    SizeChanged="OnWorkspaceSizeChanged"
    Unloaded="OnUnloaded">
    <Grid x:Name="WorkspaceRoot" Background="Transparent">
        <!-- Empty state -->
        <Grid x:Name="EmptyStateHost" Padding="24" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" MaxWidth="520">
                <Grid>
                    <Border x:Name="EmptyCard" CornerRadius="14" Padding="40,36"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="16" HorizontalAlignment="Center">
                            <FontIcon x:Name="EmptyIcon" Glyph="&#xE714;" FontSize="40"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      HorizontalAlignment="Center" />
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}"
                                           TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock x:Name="EmptyHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                           TextAlignment="Center" MaxWidth="420" />
                            </StackPanel>

                            <StackPanel x:Name="EmptyLoadingPanel" Spacing="12" HorizontalAlignment="Center" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <ProgressRing x:Name="EmptyProgress" Width="18" Height="18" IsActive="False" />
                                    <TextBlock x:Name="EmptyLoadingLabel" Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button x:Name="EmptyCancelButton" HorizontalAlignment="Center" Click="OnCancel" />
                            </StackPanel>

                            <StackPanel x:Name="EmptyActionPanel" Spacing="10" HorizontalAlignment="Center">
                                <Button x:Name="ChooseVideoButton" Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Center" Click="OnChooseVideo">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                                        <TextBlock x:Name="ChooseVideoLabel" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="EmptyDropHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Rectangle x:Name="EmptyDashedBorder" RadiusX="14" RadiusY="14"
                               Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                               StrokeThickness="1.5" StrokeDashArray="5,4"
                               IsHitTestVisible="False" />
                </Grid>

                <InfoBar x:Name="EmptyErrorBar" Severity="Error" IsClosable="False" IsOpen="False" />

                <TextBlock x:Name="SdrHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Loaded editor & result workspace -->
        <Grid x:Name="EditorHost" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Compact workspace header -->
            <Grid Padding="24,10,24,10" ColumnSpacing="12"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border CornerRadius="6" Padding="10,5"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE714;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock x:Name="FileNameLabel" Style="{StaticResource CaptionTextBlockStyle}"
                                   FontWeight="SemiBold" MaxWidth="280" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Button x:Name="ChangeVideoButton" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}"
                        VerticalAlignment="Center" Click="OnChooseVideo" />

                <SelectorBar x:Name="ViewModeBar" Grid.Column="3" Visibility="Collapsed"
                             SelectionChanged="OnViewModeChanged" VerticalAlignment="Center">
                    <SelectorBarItem x:Name="EditModeTab" Tag="edit" />
                    <SelectorBarItem x:Name="ResultModeTab" Tag="result" />
                </SelectorBar>
            </Grid>

            <!-- Adaptive main content (wide two-column / narrow stacked) -->
            <ScrollViewer x:Name="ContentScroll" Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="WorkspaceLayout">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="StageColumn" Width="*" />
                        <ColumnDefinition x:Name="DividerColumn" Width="1" />
                        <ColumnDefinition x:Name="InspectorColumn" Width="284" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Left stage (edit or result) -->
                    <Grid x:Name="StageArea" Grid.Row="0" Grid.Column="0" Padding="24,18,24,20" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <!-- Edit stage -->
                            <Grid x:Name="EditStage" RowSpacing="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Video preview + crop overlay -->
                                <Border x:Name="PreviewContainer" MinHeight="220" CornerRadius="12"
                                        Background="#FF000000" SizeChanged="OnPreviewContainerSizeChanged">
                                    <Grid>
                                        <Grid x:Name="FittedVideoHost" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <MediaPlayerElement x:Name="VideoPlayerElement"
                                                                AreTransportControlsEnabled="False"
                                                                Stretch="Uniform" />
                                            <Image x:Name="FallbackPreviewImage" Stretch="Uniform" Visibility="Collapsed" />
                                            <creator:CreatorCropOverlay x:Name="CropOverlay" />
                                        </Grid>

                                        <Border x:Name="FramePreviewBadge" Visibility="Collapsed"
                                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                Margin="10" Padding="10,5" CornerRadius="8" Background="#B8000000"
                                                IsHitTestVisible="False">
                                            <TextBlock x:Name="FramePreviewLabel" Foreground="#FFFFFFFF"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <creator:CreatorTimeline x:Name="Timeline" Grid.Row="1" />

                                <TextBlock x:Name="CropHintLabel" Grid.Row="2"
                                           Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>

                            <!-- Result stage -->
                            <creator:CreatorResultView x:Name="ResultView" Visibility="Collapsed" />
                        </Grid>

                        <InfoBar x:Name="StageErrorBar" Grid.Row="1" Severity="Error" IsClosable="False" IsOpen="False" />
                    </Grid>

                    <!-- Separator -->
                    <Rectangle x:Name="VerticalDivider" Grid.Row="0" Grid.Column="1"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Rectangle x:Name="HorizontalDivider" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                               Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Visibility="Collapsed" />

                    <!-- Right output inspector -->
                    <creator:CreatorOutputSettings x:Name="OutputSettings" Grid.Row="0" Grid.Column="2" />
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Drag-and-drop overlay when replacing a loaded video -->
        <Grid x:Name="DropOverlay" Visibility="Collapsed" Padding="18" IsHitTestVisible="False">
            <Border CornerRadius="14" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" Opacity="0.92" />
            <Rectangle RadiusX="14" RadiusY="14" Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                       StrokeThickness="2" StrokeDashArray="6,5" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE896;" FontSize="32" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="DropOverlayLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
