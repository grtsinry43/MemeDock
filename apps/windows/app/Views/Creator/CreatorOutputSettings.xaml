<UserControl
    x:Class="MemeDock.Windows.Views.Creator.CreatorOutputSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="using:MemeDock.Windows.Controls">
    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.Resources>
            <Style x:Key="ChoiceChipStyle" TargetType="ToggleButton">
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SettingsBody" Spacing="20" Padding="18">
                <!-- Crop section -->
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock x:Name="CropHeader" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="ResetCropButton" HorizontalAlignment="Right" Padding="8,3"
                                Style="{StaticResource SubtleButtonStyle}" Visibility="Collapsed"
                                Click="OnResetCrop" />
                    </Grid>

                    <md:WrapPanel x:Name="AspectChips">
                        <ToggleButton x:Name="AspectFull" Tag="full" Style="{StaticResource ChoiceChipStyle}" Click="OnAspectClick" />
                        <ToggleButton x:Name="Aspect1x1" Tag="1:1" Content="1:1" Style="{StaticResource ChoiceChipStyle}" Click="OnAspectClick" />
                        <ToggleButton x:Name="Aspect4x3" Tag="4:3" Content="4:3" Style="{StaticResource ChoiceChipStyle}" Click="OnAspectClick" />
                        <ToggleButton x:Name="Aspect16x9" Tag="16:9" Content="16:9" Style="{StaticResource ChoiceChipStyle}" Click="OnAspectClick" />
                        <ToggleButton x:Name="Aspect9x16" Tag="9:16" Content="9:16" Style="{StaticResource ChoiceChipStyle}" Click="OnAspectClick" />
                    </md:WrapPanel>

                    <TextBlock x:Name="CroppedSizeText" Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                               Typography.NumeralAlignment="Tabular" Visibility="Collapsed" />
                </StackPanel>

                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Output section -->
                <StackPanel Spacing="16">
                    <TextBlock x:Name="OutputHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <StackPanel Spacing="6">
                        <TextBlock x:Name="LongestEdgeLabel" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="Edge128" Grid.Column="0" Tag="128" Content="128" HorizontalAlignment="Stretch" Style="{StaticResource ChoiceChipStyle}" Click="OnEdgeClick" />
                            <ToggleButton x:Name="Edge256" Grid.Column="1" Tag="256" Content="256" HorizontalAlignment="Stretch" Style="{StaticResource ChoiceChipStyle}" Click="OnEdgeClick" />
                            <ToggleButton x:Name="Edge384" Grid.Column="2" Tag="384" Content="384" HorizontalAlignment="Stretch" Style="{StaticResource ChoiceChipStyle}" Click="OnEdgeClick" />
                            <ToggleButton x:Name="Edge512" Grid.Column="3" Tag="512" Content="512" HorizontalAlignment="Stretch" Style="{StaticResource ChoiceChipStyle}" Click="OnEdgeClick" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock x:Name="FrameRateLabel" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="Fps10" Grid.Column="0" Tag="10" Content="10" HorizontalAlignment="Stretch" Style="{StaticResource ChoiceChipStyle}" Click="OnFpsClick" />
                            <ToggleButton x:Name="Fps15" Grid.Column="1" Tag="15" Content="15" HorizontalAlignment="Stretch" Style="{StaticResource ChoiceChipStyle}" Click="OnFpsClick" />
                            <ToggleButton x:Name="Fps20" Grid.Column="2" Tag="20" Content="20" HorizontalAlignment="Stretch" Style="{StaticResource ChoiceChipStyle}" Click="OnFpsClick" />
                            <ToggleButton x:Name="Fps24" Grid.Column="3" Tag="24" Content="24" HorizontalAlignment="Stretch" Style="{StaticResource ChoiceChipStyle}" Click="OnFpsClick" />
                            <ToggleButton x:Name="Fps30" Grid.Column="4" Tag="30" Content="30" HorizontalAlignment="Stretch" Style="{StaticResource ChoiceChipStyle}" Click="OnFpsClick" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock x:Name="QualityLabel" Style="{StaticResource SecondaryCaptionTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="QualityValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular" />
                        </Grid>
                        <Slider x:Name="QualitySlider" Minimum="30" Maximum="100" StepFrequency="1"
                                IsThumbToolTipEnabled="False" ValueChanged="OnQualityChanged" />
                    </StackPanel>

                    <Border x:Name="EstimateCard" CornerRadius="6" Padding="10,8" Visibility="Collapsed"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE740;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="EstimateText" Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="WebpHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Pinned footer action -->
        <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Padding="18,14">
            <StackPanel Spacing="8">
                <Button x:Name="GenerateButton" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch" Click="OnGenerate">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <FontIcon x:Name="GenerateIcon" Glyph="&#xE734;" FontSize="14" />
                        <TextBlock x:Name="GenerateLabel" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelButton" HorizontalAlignment="Stretch" Visibility="Collapsed" Click="OnCancel" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
