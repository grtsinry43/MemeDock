<UserControl
    x:Class="MemeDock.Windows.Views.Creator.CreatorTimeline"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="using:MemeDock.Windows.Controls">
    <StackPanel Spacing="10">
        <!-- Transport bar -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="PlayPauseButton" Width="32" Height="32" Padding="0" Click="OnPlayPause">
                <FontIcon x:Name="PlayPauseGlyph" Glyph="&#xE768;" FontSize="13" />
            </Button>

            <TextBlock x:Name="PlayheadTime" Grid.Column="1" MinWidth="56" VerticalAlignment="Center"
                       Style="{StaticResource BodyStrongTextBlockStyle}" Typography.NumeralAlignment="Tabular" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="SetStartButton" Width="28" Height="28" Padding="0"
                        Style="{StaticResource SubtleButtonStyle}" Click="OnSetStartFromPlayhead">
                    <FontIcon Glyph="&#xE892;" FontSize="12" />
                </Button>
                <Button x:Name="SetEndButton" Width="28" Height="28" Padding="0"
                        Style="{StaticResource SubtleButtonStyle}" Click="OnSetEndFromPlayhead">
                    <FontIcon Glyph="&#xE893;" FontSize="12" />
                </Button>
            </StackPanel>

            <Border Grid.Column="4" VerticalAlignment="Center" CornerRadius="6" Padding="10,4"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="RangeText" Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                               Typography.NumeralAlignment="Tabular" />
                    <TextBlock Text="·" Style="{StaticResource SecondaryCaptionTextBlockStyle}" Opacity="0.6" />
                    <TextBlock x:Name="DurationText" Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filmstrip scrubber & trimmer -->
        <Grid x:Name="TrackHost" Height="62" SizeChanged="OnTrackSizeChanged">
            <!-- Clipped filmstrip + dimmed exterior + scrub gesture -->
            <Border CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Height="58" VerticalAlignment="Center">
                <Grid x:Name="FilmstripSurface" Background="Transparent"
                      PointerPressed="OnScrubPressed" PointerMoved="OnScrubMoved"
                      PointerReleased="OnScrubReleased" PointerCaptureLost="OnPointerCaptureLost">
                    <Grid x:Name="ThumbnailsGrid" IsHitTestVisible="False" />
                    <Canvas IsHitTestVisible="False">
                        <Rectangle x:Name="LeftDim" Fill="#94000000" Height="58" />
                        <Rectangle x:Name="RightDim" Fill="#94000000" Height="58" />
                    </Canvas>
                </Grid>
            </Border>

            <!-- Selection rails, slide bar, handles, and playhead -->
            <Canvas x:Name="OverlayCanvas" Height="62" VerticalAlignment="Center">
                <Border x:Name="SelectionFrame" Height="58" CornerRadius="8"
                        BorderBrush="#FFFFFFFF" BorderThickness="2.5"
                        Canvas.Top="2" IsHitTestVisible="False" />

                <md:CursorGrid x:Name="RangeSlideGrip" Height="16" Background="Transparent" CursorShape="SizeAll"
                               Canvas.Top="2" Visibility="Collapsed"
                               PointerPressed="OnSlidePressed" PointerMoved="OnSlideMoved"
                               PointerReleased="OnSlideReleased" PointerCaptureLost="OnPointerCaptureLost">
                    <Border x:Name="SlideBarVisual" Height="3" Width="32" CornerRadius="1.5"
                            Background="#E6FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False" />
                </md:CursorGrid>

                <!-- Playhead indicator -->
                <StackPanel x:Name="PlayheadNeedle" Spacing="0" IsHitTestVisible="False" Canvas.Top="0">
                    <Border Width="8" Height="4" CornerRadius="2" Background="#FFFFFFFF" HorizontalAlignment="Center" />
                    <Rectangle Width="2" Height="58" Fill="#FFFFFFFF" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Left trim handle -->
                <md:CursorGrid x:Name="LeftHandle" Width="14" Height="58" Canvas.Top="2"
                               CursorShape="SizeWestEast" Background="#FFFFFFFF" CornerRadius="8,2,2,8"
                               PointerPressed="OnLeftHandlePressed" PointerMoved="OnHandleMoved"
                               PointerReleased="OnHandleReleased" PointerCaptureLost="OnPointerCaptureLost">
                    <Border Width="2.5" Height="22" CornerRadius="1.25" Background="#6B000000"
                            HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                </md:CursorGrid>

                <!-- Right trim handle -->
                <md:CursorGrid x:Name="RightHandle" Width="14" Height="58" Canvas.Top="2"
                               CursorShape="SizeWestEast" Background="#FFFFFFFF" CornerRadius="2,8,8,2"
                               PointerPressed="OnRightHandlePressed" PointerMoved="OnHandleMoved"
                               PointerReleased="OnHandleReleased" PointerCaptureLost="OnPointerCaptureLost">
                    <Border Width="2.5" Height="22" CornerRadius="1.25" Background="#6B000000"
                            HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                </md:CursorGrid>
            </Canvas>
        </Grid>
    </StackPanel>
</UserControl>
