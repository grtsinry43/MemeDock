<UserControl
    x:Class="MemeDock.Windows.Views.Creator.CreatorResultView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Unloaded="OnUnloaded">
    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="StaleBar" Severity="Warning" IsClosable="False" IsOpen="False">
            <InfoBar.ActionButton>
                <Button x:Name="RegenerateButton" Style="{StaticResource AccentButtonStyle}" Click="OnRegenerate" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Animated WebP preview card -->
        <Border Grid.Row="1" MinHeight="220" CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid Padding="18">
                <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <StackPanel x:Name="BrokenState" Visibility="Collapsed" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7BA;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="BrokenLabel" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Measured WebP metadata pill -->
        <Border x:Name="MetadataPill" Grid.Row="2" HorizontalAlignment="Center" CornerRadius="6" Padding="12,6"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="WebP" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="·" Style="{StaticResource SecondaryCaptionTextBlockStyle}" Opacity="0.6" />
                <TextBlock x:Name="DimensionsText" Style="{StaticResource SecondaryCaptionTextBlockStyle}" Typography.NumeralAlignment="Tabular" />
                <TextBlock Text="·" Style="{StaticResource SecondaryCaptionTextBlockStyle}" Opacity="0.6" />
                <TextBlock x:Name="DurationText" Style="{StaticResource SecondaryCaptionTextBlockStyle}" Typography.NumeralAlignment="Tabular" />
                <TextBlock Text="·" Style="{StaticResource SecondaryCaptionTextBlockStyle}" Opacity="0.6" />
                <TextBlock x:Name="FpsText" Style="{StaticResource SecondaryCaptionTextBlockStyle}" Typography.NumeralAlignment="Tabular" />
                <TextBlock Text="·" Style="{StaticResource SecondaryCaptionTextBlockStyle}" Opacity="0.6" />
                <TextBlock x:Name="SizeText" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
            </StackPanel>
        </Border>

        <!-- Actions: Add to Dock, Copy, Save As, Share -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
            <Button x:Name="AddButton" Style="{StaticResource AccentButtonStyle}" Click="OnAddToDock">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="SavingRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    <FontIcon x:Name="AddIcon" Glyph="&#xE710;" FontSize="14" />
                    <TextBlock x:Name="AddLabel" />
                </StackPanel>
            </Button>

            <Button x:Name="CopyButton" Click="OnCopy">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                    <TextBlock x:Name="CopyLabel" />
                </StackPanel>
            </Button>

            <Button x:Name="SaveButton" Click="OnSave">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE792;" FontSize="14" />
                    <TextBlock x:Name="SaveLabel" />
                </StackPanel>
            </Button>

            <Button x:Name="ShareButton" Click="OnShare">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72D;" FontSize="14" />
                    <TextBlock x:Name="ShareLabel" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock x:Name="ResultHint" Grid.Row="4" Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                   TextAlignment="Center" MaxWidth="520" HorizontalAlignment="Center" />
    </Grid>
</UserControl>
