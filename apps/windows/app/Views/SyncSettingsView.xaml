<UserControl
    x:Class="MemeDock.Windows.Views.SyncSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="20,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE895;" FontSize="20" VerticalAlignment="Center" />
                <TextBlock x:Name="SyncLabel" Grid.Column="1" VerticalAlignment="Center"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <InfoBar x:Name="ErrorBar" IsClosable="False" IsOpen="False" Severity="Error" />

            <StackPanel x:Name="ConnectForm" Spacing="8" Visibility="Collapsed">
                <TextBox x:Name="OriginBox" />
                <PasswordBox x:Name="TokenBox" PasswordRevealMode="Peek" />
                <TextBlock x:Name="TokenHint" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ConnectButton" Click="OnConnect" Style="{ThemeResource AccentButtonStyle}" />
                    <Button x:Name="CancelButton" Click="OnCancel" Visibility="Collapsed" />
                    <Button x:Name="InlineDisconnectButton" Click="OnDisconnect" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="StatusPanel" Spacing="8" Visibility="Collapsed">
                <Grid ColumnSpacing="16" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ServerLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="OriginValue" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="PendingLabel" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="PendingValue" Grid.Row="1" Grid.Column="1" />
                    <TextBlock x:Name="BlockedLabel" Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="BlockedValue" Grid.Row="2" Grid.Column="1" />
                    <TextBlock x:Name="LastSyncLabel" Grid.Row="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="LastSyncValue" Grid.Row="3" Grid.Column="1" />
                </Grid>
                <TextBlock x:Name="BlockedHint" Visibility="Collapsed" TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SyncNowButton" Click="OnSynchronize" Style="{ThemeResource AccentButtonStyle}" />
                    <Button x:Name="PauseButton" Click="OnTogglePause" />
                    <Button x:Name="TokenButton" Click="OnEditToken" />
                    <Button x:Name="DisconnectButton" Click="OnDisconnect" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="MergeHint" Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="BackgroundHint" Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
