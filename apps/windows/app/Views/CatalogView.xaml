<UserControl x:Class="MemeDock.Windows.Views.CatalogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bridge="using:MemeDock.Bridge">
    <ScrollViewer x:Name="Viewport" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,24" Spacing="24" Width="{Binding ActualWidth, ElementName=Viewport}" MaxWidth="880" HorizontalAlignment="Center">
            <TextBlock x:Name="Heading" Style="{ThemeResource TitleTextBlockStyle}" />
            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" />
            <InfoBar x:Name="MessageBar" Severity="Success" IsClosable="True">
                <InfoBar.ActionButton><Button x:Name="UndoButton" Click="OnUndo" /></InfoBar.ActionButton>
            </InfoBar>
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
            <UserControl x:Name="Actions"><StackPanel Spacing="20">
                <Expander x:Name="CollectionSection" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header><StackPanel Orientation="Horizontal" Spacing="12"><SymbolIcon Symbol="Folder" /><TextBlock x:Name="CollectionsHeading" VerticalAlignment="Center" /></StackPanel></Expander.Header>
                    <StackPanel Spacing="12">
                        <Button x:Name="NewCollection" Click="OnNewCollection" Style="{StaticResource SubtleButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Add" /><TextBlock x:Name="NewCollectionLabel" VerticalAlignment="Center" /></StackPanel></Button>
                        <TextBlock x:Name="EmptyCollections" TextWrapping="Wrap" />
                        <ListView x:Name="Collections" MaxHeight="320" CanDragItems="True" CanReorderItems="True" AllowDrop="True" DragItemsCompleted="OnCollectionsReordered">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="bridge:CollectionMetadata">
                                    <Grid ColumnSpacing="12" MinHeight="48">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button Tag="{x:Bind}" Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Click="OnCollectionMenu" Loaded="OnMenuLoaded"><FontIcon Glyph="&#xE712;" FontSize="16" /></Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Expander>
                <Expander x:Name="TagSection" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header><StackPanel Orientation="Horizontal" Spacing="12"><SymbolIcon Symbol="Tag" /><TextBlock x:Name="TagsHeading" VerticalAlignment="Center" /></StackPanel></Expander.Header>
                    <StackPanel Spacing="12">
                        <Button x:Name="NewTag" Click="OnNewTag" Style="{StaticResource SubtleButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Add" /><TextBlock x:Name="NewTagLabel" VerticalAlignment="Center" /></StackPanel></Button>
                        <TextBlock x:Name="EmptyTags" TextWrapping="Wrap" />
                        <ListView x:Name="Tags" MaxHeight="320">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="bridge:TagMetadata">
                                    <Grid ColumnSpacing="12" MinHeight="48">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8EC;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button Tag="{x:Bind}" Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Click="OnTagMenu" Loaded="OnMenuLoaded"><FontIcon Glyph="&#xE712;" FontSize="16" /></Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Expander>
            </StackPanel></UserControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
