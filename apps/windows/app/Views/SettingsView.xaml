<UserControl x:Class="MemeDock.Windows.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MemeDock.Windows.Views">
    <ScrollViewer x:Name="Viewport" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Width="{Binding ActualWidth, ElementName=Viewport}" MaxWidth="760" HorizontalAlignment="Center" Padding="32,24">
            <TextBlock x:Name="Heading" Style="{ThemeResource TitleTextBlockStyle}" />
            <Border Padding="20,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <FontIcon Glyph="&#xE774;" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock x:Name="LanguageLabel" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <ComboBox x:Name="LanguageSelector" Grid.Column="2" MinWidth="160" MaxWidth="240" HorizontalAlignment="Right" SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem x:Name="SystemLanguage" Tag="System" />
                        <ComboBoxItem x:Name="ChineseLanguage" Tag="Chinese" />
                        <ComboBoxItem x:Name="EnglishLanguage" Tag="English" />
                    </ComboBox>
                    <InfoBar x:Name="SaveError" Grid.Row="1" Grid.ColumnSpan="3" IsClosable="False" Severity="Error" />
                </Grid>
            </Border>
            <views:SyncSettingsView x:Name="SyncPanel" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
