<UserControl x:Class="MemeDock.Windows.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="24" MaxWidth="680" HorizontalAlignment="Stretch">
            <TextBlock x:Name="Heading" Style="{ThemeResource TitleTextBlockStyle}" />
            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="12">
                    <ComboBox x:Name="LanguageSelector" HorizontalAlignment="Stretch" SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem x:Name="SystemLanguage" Tag="System" />
                        <ComboBoxItem x:Name="ChineseLanguage" Tag="Chinese" />
                        <ComboBoxItem x:Name="EnglishLanguage" Tag="English" />
                    </ComboBox>
                    <InfoBar x:Name="SaveError" IsClosable="False" Severity="Error" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
