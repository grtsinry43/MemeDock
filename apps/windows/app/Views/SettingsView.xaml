<UserControl x:Class="MemeDock.Windows.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="using:MemeDock.Windows.Controls"
    xmlns:views="using:MemeDock.Windows.Views">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="{StaticResource SettingsCardSpacing}" MaxWidth="{StaticResource SettingsPageMaxWidth}"
                    HorizontalAlignment="Stretch" Padding="36,20,36,36">
            <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />

            <!-- General -->
            <TextBlock x:Name="GeneralHeader" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
            <md:SettingsRow x:Name="AppearanceRow" Glyph="&#xE790;">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <HyperlinkButton x:Name="WindowsColors" NavigateUri="ms-settings:colors" VerticalAlignment="Center" />
                    <ComboBox x:Name="AppearanceSelector" MinWidth="180" SelectionChanged="OnAppearanceChanged" VerticalAlignment="Center">
                        <ComboBoxItem x:Name="SystemAppearance" Tag="System" />
                        <ComboBoxItem x:Name="LightAppearance" Tag="Light" />
                        <ComboBoxItem x:Name="DarkAppearance" Tag="Dark" />
                    </ComboBox>
                </StackPanel>
            </md:SettingsRow>
            <InfoBar x:Name="AppearanceError" IsClosable="False" Severity="Error" />
            <md:SettingsRow x:Name="LanguageRow" Glyph="&#xE774;">
                <ComboBox x:Name="LanguageSelector" MinWidth="180" SelectionChanged="OnLanguageChanged">
                    <ComboBoxItem x:Name="SystemLanguage" Tag="System" />
                    <ComboBoxItem x:Name="ChineseLanguage" Tag="Chinese" />
                    <ComboBoxItem x:Name="EnglishLanguage" Tag="English" />
                </ComboBox>
            </md:SettingsRow>
            <InfoBar x:Name="SaveError" IsClosable="False" Severity="Error" />

            <!-- Desktop integration follows the page's existing expandable settings groups. -->
            <StackPanel x:Name="DesktopRows" Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock x:Name="DesktopSectionHeader" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <Grid ColumnSpacing="16" Padding="0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7E8;" FontSize="20" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="ResidentGroupLabel"/>
                                <TextBlock x:Name="ResidentHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <Grid Padding="36,0,0,0" ColumnSpacing="24" RowSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock x:Name="TaskbarLabel" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <ToggleSwitch x:Name="ShowTaskbar" Grid.Column="1" Toggled="OnDesktopToggle"/>
                        <TextBlock x:Name="StartupLabel" Grid.Row="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <ToggleSwitch x:Name="LaunchAtLogin" Grid.Row="1" Grid.Column="1" Toggled="OnStartupToggle"/>
                        <HyperlinkButton x:Name="StartupSettings" Grid.Row="2" Grid.ColumnSpan="2" NavigateUri="ms-settings:startupapps" Padding="0"/>
                    </Grid>
                </Expander>
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <Grid ColumnSpacing="16" Padding="0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE76E;" FontSize="20" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PickerGroupLabel" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Expander.Header>
                    <Grid Padding="36,0,0,0" ColumnSpacing="24" RowSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock x:Name="ShortcutLabel" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ShortcutRecorderButton" Click="OnEditShortcut" Padding="8,4">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <views:ShortcutKeys x:Name="ShortcutPreview"/>
                                    <TextBlock x:Name="ShortcutPlaceholder" VerticalAlignment="Center"/>
                                    <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ClearShortcut" Click="OnClearShortcut"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="AnchorLabel" TextWrapping="Wrap"/>
                            <TextBlock x:Name="AnchorHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="AnchorInput" Grid.Row="1" Grid.Column="1" Toggled="OnDesktopToggle"/>
                        <TextBlock x:Name="PasteHint" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource SecondaryCaptionTextBlockStyle}"/>
                    </Grid>
                </Expander>
            </StackPanel>
            <InfoBar x:Name="DesktopError" IsClosable="True" Severity="Error" />

            <!-- Output -->
            <TextBlock x:Name="OutputLabel" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8C8;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="CopyGroupLabel" TextWrapping="Wrap" />
                            <TextBlock x:Name="CopyGroupHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <Grid ColumnSpacing="16" RowSpacing="16" Padding="36,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="CopyStillLabel" />
                        <TextBlock x:Name="CopyStillHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="CopyStillSelector" Grid.Column="1" MinWidth="200" VerticalAlignment="Center" SelectionChanged="OnOutputPresetChanged" />
                    <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="CopyAnimatedLabel" />
                        <TextBlock x:Name="CopyAnimatedHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="CopyAnimatedSelector" Grid.Row="1" Grid.Column="1" MinWidth="200" VerticalAlignment="Center" SelectionChanged="OnOutputPresetChanged" />
                </Grid>
            </Expander>
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7C2;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="DragGroupLabel" TextWrapping="Wrap" />
                            <TextBlock x:Name="DragGroupHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <Grid ColumnSpacing="16" RowSpacing="16" Padding="36,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="DragStillLabel" />
                        <TextBlock x:Name="DragStillHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="DragStillSelector" Grid.Column="1" MinWidth="200" VerticalAlignment="Center" SelectionChanged="OnOutputPresetChanged" />
                    <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="DragAnimatedLabel" />
                        <TextBlock x:Name="DragAnimatedHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="DragAnimatedSelector" Grid.Row="1" Grid.Column="1" MinWidth="200" VerticalAlignment="Center" SelectionChanged="OnOutputPresetChanged" />
                </Grid>
            </Expander>
            <InfoBar x:Name="OutputError" IsClosable="False" Severity="Error" />

            <!-- Sync -->
            <TextBlock x:Name="SyncHeader" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
            <views:SyncSettingsView x:Name="SyncPanel" />

            <!-- Backup and restore -->
            <TextBlock x:Name="BackupSectionHeader" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
            <md:SettingsRow x:Name="BackupRow" Glyph="&#xE896;">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="BackupStage" Style="{StaticResource SecondaryCaptionTextBlockStyle}" VerticalAlignment="Center" MaxWidth="220" />
                    <ProgressRing x:Name="BackupProgress" Width="16" Height="16" IsActive="False" VerticalAlignment="Center" />
                    <Button x:Name="CreateBackupButton" Style="{StaticResource AccentButtonStyle}" Click="OnCreateBackup" />
                </StackPanel>
            </md:SettingsRow>
            <InfoBar x:Name="BackupBar" IsClosable="True" />
            <Grid x:Name="BackupSavedPanel" ColumnSpacing="16" Visibility="Collapsed" Padding="16,4,16,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="BackupSavedLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="BackupSavedValue" Grid.Column="1" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Grid>
            <md:SettingsRow x:Name="CheckpointRow" Glyph="&#xE81C;">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressRing x:Name="CheckpointProgress" Width="16" Height="16" IsActive="False" VerticalAlignment="Center" />
                    <Button x:Name="CreateCheckpointButton" Click="OnCreateCheckpoint" />
                </StackPanel>
            </md:SettingsRow>
            <InfoBar x:Name="CheckpointBar" IsClosable="True" />
            <Expander x:Name="RestoreExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE777;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="RestoreLabel" TextWrapping="Wrap" />
                            <TextBlock x:Name="RestoreHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="16" Padding="36,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="ChooseArchiveButton" Click="OnChooseArchive" />
                        <ProgressRing x:Name="InspectProgress" Width="16" Height="16" IsActive="False" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="PreviewPanel" Spacing="16" Visibility="Collapsed">
                        <Grid ColumnSpacing="16" RowSpacing="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock x:Name="PreviewSourceLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="PreviewSourceValue" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock x:Name="PreviewSizeLabel" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="PreviewSizeValue" Grid.Row="1" Grid.Column="1" />
                        </Grid>
                        <Grid ColumnSpacing="24" RowSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="PreviewStickersLabel" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                <TextBlock x:Name="PreviewStickersValue" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="PreviewDeletedLabel" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                <TextBlock x:Name="PreviewDeletedValue" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="PreviewCollectionsLabel" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                <TextBlock x:Name="PreviewCollectionsValue" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1">
                                <TextBlock x:Name="PreviewTagsLabel" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                <TextBlock x:Name="PreviewTagsValue" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock x:Name="PreviewOriginalsLabel" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                <TextBlock x:Name="PreviewOriginalsValue" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="PredictionPanel" Spacing="4">
                            <TextBlock x:Name="PredictionLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="PredictionValue" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="ModeLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <RadioButton x:Name="MergeOption" GroupName="RestoreMode" Checked="OnRestoreModeChanged">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="MergeOptionLabel" />
                                    <TextBlock x:Name="MergeOptionHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ReplaceOption" GroupName="RestoreMode" Checked="OnRestoreModeChanged">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="ReplaceOptionLabel" />
                                    <TextBlock x:Name="ReplaceOptionHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="ApplyRestoreButton" Style="{StaticResource AccentButtonStyle}" Click="OnApplyRestore" />
                            <ProgressRing x:Name="RestoreProgress" Width="16" Height="16" IsActive="False" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <InfoBar x:Name="RestoreBar" IsClosable="True" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="RestoreState" Style="{StaticResource SecondaryCaptionTextBlockStyle}" VerticalAlignment="Center" Visibility="Collapsed" />
                        <Button x:Name="RetryRestoreRefreshButton" Click="OnRetryRestoreRefresh" Visibility="Collapsed" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- Storage -->
            <TextBlock x:Name="StorageHeader" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
            <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEDA2;" FontSize="20" VerticalAlignment="Center" />
                        <TextBlock x:Name="StorageSpaceLabel" Grid.Column="1" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressRing x:Name="StorageProgress" Width="16" Height="16" IsActive="False" />
                            <Button x:Name="StorageRefresh" Style="{StaticResource SubtleButtonStyle}" Padding="8" Click="OnStorageRefresh">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="16" Padding="36,0,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="OriginalCountLabel" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                            <TextBlock x:Name="OriginalCountValue" Style="{StaticResource SubtitleTextBlockStyle}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="SavedOriginalsLabel" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                            <TextBlock x:Name="SavedOriginalsValue" Style="{StaticResource SubtitleTextBlockStyle}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock x:Name="CacheUsageLabel" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                            <TextBlock x:Name="CacheUsageValue" Style="{StaticResource SubtitleTextBlockStyle}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="StorageHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" Padding="36,0,0,0" />
                    <InfoBar x:Name="StorageNotice" IsClosable="False" Severity="Informational" />
                    <InfoBar x:Name="StorageError" IsClosable="False" Severity="Error">
                        <InfoBar.ActionButton><Button x:Name="StorageRetry" Click="OnStorageRefresh" /></InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>
            </Border>
            <md:SettingsRow x:Name="CleanupRow" Glyph="&#xE74D;">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressRing x:Name="CleanProgress" Width="16" Height="16" IsActive="False" VerticalAlignment="Center" />
                    <Button x:Name="CleanButton" Click="OnCleanArtifacts" />
                </StackPanel>
            </md:SettingsRow>
            <InfoBar x:Name="CleanupBar" IsClosable="True" />
            <md:SettingsRow x:Name="ExportCollectionsRow" Glyph="&#xE72D;">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="ExportCollectionsStage" Style="{StaticResource SecondaryCaptionTextBlockStyle}" VerticalAlignment="Center" MaxWidth="220" />
                    <ProgressRing x:Name="ExportCollectionsProgress" Width="16" Height="16" IsActive="False" VerticalAlignment="Center" />
                    <Button x:Name="CancelExportCollectionsButton" Click="OnCancelCollectionExport" Visibility="Collapsed" />
                    <Button x:Name="ExportCollectionsButton" Click="OnExportCollections" />
                </StackPanel>
            </md:SettingsRow>
            <InfoBar x:Name="ExportCollectionsBar" IsClosable="True" />
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE838;" FontSize="20" VerticalAlignment="Center" />
                        <TextBlock x:Name="LocationsLabel" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="12" Padding="36,0,0,0">
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="DataDirectoryLabel" VerticalAlignment="Center" />
                        <TextBlock x:Name="DataDirectoryValue" Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                        <Button x:Name="OpenDataDirectory" Grid.Column="2" Click="OnOpenDataDirectory" />
                        <TextBlock x:Name="CacheDirectoryLabel" Grid.Row="1" VerticalAlignment="Center" />
                        <TextBlock x:Name="CacheDirectoryValue" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                        <Button x:Name="OpenCacheDirectory" Grid.Row="1" Grid.Column="2" Click="OnOpenCacheDirectory" />
                        <TextBlock x:Name="ShareDirectoryLabel" Grid.Row="2" VerticalAlignment="Center" />
                        <TextBlock x:Name="ShareDirectoryValue" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                        <Button x:Name="OpenShareDirectory" Grid.Row="2" Grid.Column="2" Click="OnOpenShareDirectory" />
                    </Grid>
                    <InfoBar x:Name="DirectoryBar" IsClosable="True" />
                </StackPanel>
            </Expander>

            <!-- About -->
            <TextBlock x:Name="AboutLabel" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,12,16,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Image Source="ms-appx:///Assets/MemeDock.png" Width="20" Height="20" VerticalAlignment="Center" Stretch="Uniform" />
                        <TextBlock x:Name="AboutTitle" Grid.Column="1" Text="MemeDock" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="VersionValue" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="16" Padding="36,0,0,0">
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="LibraryIdLabel" VerticalAlignment="Center" />
                        <TextBlock x:Name="LibraryIdValue" Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="CopyLibraryId" Grid.Column="2" IsEnabled="False" Click="OnCopyLibraryId" />
                        <TextBlock x:Name="DeviceIdLabel" Grid.Row="1" VerticalAlignment="Center" />
                        <TextBlock x:Name="DeviceIdValue" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="CopyDeviceId" Grid.Row="1" Grid.Column="2" IsEnabled="False" Click="OnCopyDeviceId" />
                    </Grid>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="LicensesLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="LicenseValue" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                    </StackPanel>
                    <InfoBar x:Name="AboutFeedback" IsClosable="True" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
