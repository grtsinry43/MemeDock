<UserControl x:Class="MemeDock.Windows.Views.StickerDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="using:MemeDock.Windows.Controls" Unloaded="OnUnloaded">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Padding="16,8,4,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="Heading" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <ProgressRing x:Name="Saving" Grid.Column="1" Width="16" Height="16" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
            <CommandBar Grid.Column="2" Background="Transparent" DefaultLabelPosition="Collapsed" OverflowButtonVisibility="Collapsed" IsDynamicOverflowEnabled="False">
                <AppBarToggleButton x:Name="StarButton" Click="OnStar"><AppBarToggleButton.Icon><FontIcon x:Name="StarGlyph" Glyph="&#xE734;" /></AppBarToggleButton.Icon></AppBarToggleButton>
                <AppBarButton x:Name="MoreButton"><AppBarButton.Icon><FontIcon Glyph="&#xE712;" /></AppBarButton.Icon>
                    <AppBarButton.Flyout><MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem x:Name="DeleteButton" Click="OnDelete" KeyboardAcceleratorTextOverride="Delete"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    </MenuFlyout></AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="CloseButton" Click="OnClose"><AppBarButton.Icon><FontIcon Glyph="&#xE711;" /></AppBarButton.Icon></AppBarButton>
            </CommandBar>
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Padding="16,4,16,24">
                <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" />

                <StackPanel x:Name="PreviewArea" Spacing="4" Visibility="Collapsed">
                    <Grid Height="208">
                        <!-- Square so a tile's picture lands without distortion; the thumbnail waits
                             underneath until the original has decoded. -->
                        <Border x:Name="DragSurface" Background="Transparent" DragStarting="OnPreviewDragStarting" DropCompleted="OnPreviewDropCompleted"
                                DoubleTapped="OnPreviewDoubleTapped" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid x:Name="PreviewFrame" Width="200" Height="200">
                                <Image x:Name="Placeholder" Stretch="Uniform" />
                                <Image x:Name="Preview" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <ProgressRing x:Name="DetailLoading" Width="24" Height="24" IsActive="False" Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button x:Name="PreviewRetry" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Click="OnPreviewRetry" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="PreviewHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" VerticalAlignment="Center" />
                        <Button x:Name="Playback" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" Visibility="Collapsed" Click="OnPlayback" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="PlaybackGlyph" Glyph="&#xE769;" FontSize="12" />
                                <TextBlock x:Name="PlaybackLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="Form" Spacing="16" Visibility="Collapsed">
                    <TextBox x:Name="NameBox" TextChanged="OnTitleChanged" LostFocus="OnEditorLostFocus" KeyDown="OnEditorKeyDown" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="CopyButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnCopy">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                                <TextBlock x:Name="CopyLabel" Grid.Column="1" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="CopyShortcut" Grid.Column="2" Text="Ctrl+C" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                <ProgressRing x:Name="CopyBusy" Grid.Column="2" Width="16" Height="16" IsActive="False" Visibility="Collapsed"
                                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Grid>
                        </Button>
                        <DropDownButton x:Name="FormatButton" Grid.Column="1">
                            <DropDownButton.Flyout><MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem x:Name="CopyOriginal" Click="OnCopyOriginal" />
                                <MenuFlyoutItem x:Name="CopyPng" Click="OnCopy" />
                                <MenuFlyoutItem x:Name="CopyFrame" Click="OnCopyFrame" />
                            </MenuFlyout></DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <TextBlock x:Name="OrganizeLabel" Style="{StaticResource PaneSectionTextBlockStyle}" />
                    <ComboBox x:Name="CollectionPicker" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="OnCollectionChosen" />
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="TagsLabel" />
                        <md:WrapPanel x:Name="TagChips">
                            <Button x:Name="AddTagButton" Style="{StaticResource TagChipButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="10" />
                                    <TextBlock x:Name="AddTagLabel" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout x:Name="TagFlyout" Opening="OnTagOpening">
                                        <StackPanel Width="248" Spacing="12">
                                            <ListView x:Name="TagChoices" DisplayMemberPath="Name" SelectionMode="Multiple"
                                                      IsMultiSelectCheckBoxEnabled="True" MaxHeight="240" />
                                            <TextBlock x:Name="NoTags" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button x:Name="ApplyTags" Click="OnApplyTags" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </md:WrapPanel>
                    </StackPanel>
                    <TextBox x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="200"
                             TextChanged="OnNoteChanged" LostFocus="OnEditorLostFocus" KeyDown="OnEditorKeyDown" />

                    <Expander x:Name="FileSection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid RowSpacing="10" ColumnSpacing="16">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="DimensionsLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="DimensionsValue" Grid.Column="1" TextAlignment="Right" TextWrapping="Wrap" />
                            <TextBlock x:Name="BytesLabel" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="BytesValue" Grid.Row="1" Grid.Column="1" TextAlignment="Right" />
                            <TextBlock x:Name="FormatLabel" Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="FormatValue" Grid.Row="2" Grid.Column="1" TextAlignment="Right" />
                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="4"><TextBlock x:Name="OriginalLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="OriginalValue" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></StackPanel>
                        </Grid>
                    </Expander>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
