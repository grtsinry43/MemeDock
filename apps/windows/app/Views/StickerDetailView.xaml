<UserControl x:Class="MemeDock.Windows.Views.StickerDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Unloaded="OnUnloaded">
    <Grid Padding="20,12,20,20" RowSpacing="16" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="Heading" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Collapsed" OverflowButtonVisibility="Collapsed" IsDynamicOverflowEnabled="False">
                <AppBarButton x:Name="CopyButton" Icon="Copy" Click="OnCopy" />
                <AppBarToggleButton x:Name="StarButton" Click="OnStar"><AppBarToggleButton.Icon><FontIcon x:Name="StarGlyph" Glyph="&#xE734;" /></AppBarToggleButton.Icon></AppBarToggleButton>
                <AppBarButton x:Name="MoreButton" Icon="More"><AppBarButton.Flyout><MenuFlyout>
                    <MenuFlyoutSubItem x:Name="CopyFormats" Icon="Copy">
                        <MenuFlyoutItem x:Name="CopyOriginal" Click="OnCopyOriginal" />
                        <MenuFlyoutItem x:Name="CopyPng" Click="OnCopy" />
                        <MenuFlyoutItem x:Name="CopyFrame" Click="OnCopyFrame" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="DeleteButton" Icon="Delete" Click="OnDelete" />
                </MenuFlyout></AppBarButton.Flyout></AppBarButton>
                <AppBarButton x:Name="CloseButton" Icon="Cancel" Click="OnClose" />
            </CommandBar>
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="20">
                <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" />
                <ProgressRing x:Name="DetailLoading" Width="24" Height="24" IsActive="False" Visibility="Collapsed" />
                <StackPanel x:Name="Form" Spacing="20">
                    <Border x:Name="DragSurface" DragStarting="OnPreviewDragStarting" DropCompleted="OnPreviewDropCompleted" Height="232" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Image x:Name="Preview" Margin="12" Stretch="Uniform" DoubleTapped="OnPreviewDoubleTapped" />
                            <Button x:Name="PreviewRetry" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Click="OnPreviewRetry" />
                            <Button x:Name="Playback" Style="{StaticResource SubtleButtonStyle}" Visibility="Collapsed" Click="OnPlayback" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Width="36" Height="36"><FontIcon x:Name="PlaybackGlyph" Glyph="&#xE769;" FontSize="16" /></Button>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="PreviewHint" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Spacing="8">
                        <Button x:Name="TitleDisplay" Style="{StaticResource SubtleButtonStyle}" Click="OnEditTitle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0,4"><TextBlock x:Name="TitleText" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" /></Button>
                        <TextBox x:Name="NameBox" Visibility="Collapsed" TextChanged="OnTitleChanged" LostFocus="OnEditorLostFocus" KeyDown="OnEditorKeyDown" />
                        <Button x:Name="NoteDisplay" Style="{StaticResource SubtleButtonStyle}" Click="OnEditNote" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0,4"><TextBlock x:Name="NoteText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Button>
                        <TextBox x:Name="NoteBox" Visibility="Collapsed" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" MaxHeight="240" TextChanged="OnNoteChanged" LostFocus="OnEditorLostFocus" KeyDown="OnEditorKeyDown" />
                        <StackPanel x:Name="DraftActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <Button x:Name="SaveButton" Style="{StaticResource AccentButtonStyle}" Click="OnSave" />
                            <Button x:Name="DiscardButton" Style="{StaticResource SubtleButtonStyle}" Click="OnDiscard" />
                            <ProgressRing x:Name="Saving" Width="18" Height="18" IsActive="False" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <Button x:Name="CollectionButton" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                <StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="CollectionLabel" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="CollectionName" TextWrapping="Wrap" /></StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="12" />
                            </Grid>
                            <Button.Flyout><Flyout x:Name="CollectionFlyout" Opening="OnCollectionOpening"><ListView x:Name="CollectionPicker" Width="248" MaxHeight="320" DisplayMemberPath="Name" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnCollectionChosen" /></Flyout></Button.Flyout>
                        </Button>
                        <Button x:Name="TagButton" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8EC;" FontSize="16" />
                                <StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="TagsLabel" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="TagSummary" TextWrapping="Wrap" /></StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="12" />
                            </Grid>
                            <Button.Flyout><Flyout x:Name="TagFlyout" Opening="OnTagOpening"><StackPanel Width="248" Spacing="12">
                                <ListView x:Name="TagChoices" DisplayMemberPath="Name" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="True" MaxHeight="240" />
                                <TextBlock x:Name="NoTags" TextWrapping="Wrap" />
                                <Button x:Name="ApplyTags" Click="OnApplyTags" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel></Flyout></Button.Flyout>
                        </Button>
                    </StackPanel>
                    <Expander x:Name="FileSection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid RowSpacing="12" ColumnSpacing="16">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="DimensionsLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="DimensionsValue" Grid.Column="1" TextAlignment="Right" TextWrapping="Wrap" />
                            <TextBlock x:Name="BytesLabel" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="BytesValue" Grid.Row="1" Grid.Column="1" TextAlignment="Right" />
                            <TextBlock x:Name="FormatLabel" Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="FormatValue" Grid.Row="2" Grid.Column="1" TextAlignment="Right" />
                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="4"><TextBlock x:Name="OriginalLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="OriginalValue" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></StackPanel>
                        </Grid>
                    </Expander>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
