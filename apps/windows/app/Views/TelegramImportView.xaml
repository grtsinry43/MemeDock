<UserControl x:Class="MemeDock.Windows.Views.TelegramImportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:MemeDock.Windows.Views">
    <Grid MinWidth="440" Height="520" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel x:Name="Credentials" Spacing="8">
            <PasswordBox x:Name="Token" PasswordChanged="OnToken"/>
            <TextBlock x:Name="TokenHint" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="12"><CheckBox x:Name="Remember" Checked="OnRemember" Unchecked="OnRemember"/><Button x:Name="Forget" Click="OnForget"/></StackPanel>
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="Query" TextChanged="OnQuery" KeyDown="OnQueryKey"/>
            <Button x:Name="Load" Grid.Column="1" Click="OnLoad" VerticalAlignment="Bottom"/>
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="PackTitle" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="SelectNew" Grid.Column="1" Click="OnSelectNew"/>
            <Button x:Name="Clear" Grid.Column="2" Click="OnClear"/>
        </Grid>
        <Grid Grid.Row="3">
            <GridView x:Name="Gallery" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItem" ContainerContentChanging="OnContainer">
                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="100" ItemHeight="126"/></ItemsPanelTemplate></GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="views:TelegramCard">
                        <Grid Width="92" Height="118" Padding="4" RowSpacing="4" AutomationProperties.Name="{x:Bind Description, Mode=OneWay}">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="{x:Bind Emoji}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{x:Bind Preview, Mode=OneWay}" Stretch="Uniform"/>
                            <CheckBox IsChecked="{x:Bind Selected, Mode=OneWay}" IsEnabled="{x:Bind Selectable, Mode=OneWay}" IsHitTestVisible="False" IsTabStop="False" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="1" Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <ProgressRing x:Name="Busy" IsActive="False" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <InfoBar x:Name="Feedback" VerticalAlignment="Bottom" MaxHeight="130" IsOpen="False"/>
        </Grid>
        <Grid Grid.Row="4" ColumnSpacing="8" RowSpacing="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ProgressBar x:Name="Progress" Grid.ColumnSpan="3"/>
            <TextBlock x:Name="Count" Grid.Row="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button x:Name="Cancel" Grid.Row="1" Grid.Column="1" Click="OnCancel"/>
            <Button x:Name="Import" Grid.Row="1" Grid.Column="2" Click="OnImport" Style="{StaticResource AccentButtonStyle}"/>
        </Grid>
    </Grid>
</UserControl>
