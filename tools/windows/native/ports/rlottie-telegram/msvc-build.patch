diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -42,6 +42,12 @@ target_include_directories(rlottie
     )
 
 #declare target compilation options
+if(NOT BUILD_SHARED_LIBS)
+target_compile_definitions(rlottie PUBLIC LOT_STATIC)
+endif()
+if(MSVC)
+target_compile_options(rlottie PRIVATE /std:c++14 /GR- /EHsc)
+else()
 target_compile_options(rlottie
                     PUBLIC
                     PRIVATE
@@ -57,6 +63,7 @@ target_compile_options(rlottie
                         -Wno-unused-parameter
                         -fvisibility=hidden
                     )
+endif()
 
 #declare dependancy
 set( CMAKE_THREAD_PREFER_PTHREAD TRUE )
@@ -77,7 +84,7 @@ if(APPLE)
                         PUBLIC
                              "-Wl, -undefined error"
                           )
-else()
+elseif(NOT WIN32)
     target_link_libraries(rlottie
                         PUBLIC
                              "-Wl,--no-undefined"
